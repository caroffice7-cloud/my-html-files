# 서버 포트
PORT=4000

# 프론트엔드 배포 주소 (CORS 허용 origin, 쉼표로 다중 지정 가능)
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# 개인정보 필드 암호화 키 (AES-256-GCM, 반드시 32바이트를 hex로 인코딩한 64자리 문자열)
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# 관리자 로그인 JWT 서명 키 (임의의 긴 무작위 문자열)
JWT_SECRET=REPLACE_WITH_RANDOM_LONG_STRING

# JWT 만료 시간
JWT_EXPIRES_IN=8h

# SQLite DB 파일 경로 (컨테이너 재시작 시에도 보존되는 볼륨을 지정할 것)
DB_PATH=./data/applications.db

# 개인정보 보관 기간(일) — 목적 달성 후 파기 기준 안내용 (제7조 2항)
DATA_RETENTION_DAYS=1825
